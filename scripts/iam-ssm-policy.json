{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPrismSecrets",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath",
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Resource": "arn:aws:ssm:*:*:parameter/prism/*"
    },
    {
      "Sid": "DecryptPrismSecrets",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.eu-north-1.amazonaws.com"
        }
      }
    }
  ]
}
