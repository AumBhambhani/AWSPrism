{
  "key": "akamai",
  "name": "Akamai",
  "category": "network_security",
  "authType": "api_key",
  "tests": [
    { "testKey": "akamai.appsec.waf_policies_in_block_mode", "title": "WAF security policies enforce in block/deny mode", "severityDefault": "high", "isoReferences": ["A.14.1.2"] },
    { "testKey": "akamai.appsec.attack_groups_enabled", "title": "All OWASP attack groups have an enforcing action", "severityDefault": "high", "isoReferences": ["A.14.2.5"] },
    { "testKey": "akamai.appsec.rate_limiting_configured", "title": "A rate-limiting policy with an enforcing action exists", "severityDefault": "medium", "isoReferences": ["A.13.1.1"] },
    { "testKey": "akamai.appsec.config_activated_on_production", "title": "Security configs are activated on production at their latest version", "severityDefault": "high", "isoReferences": ["A.12.1.2"] },
    { "testKey": "akamai.siem.integration_enabled", "title": "Security-event SIEM export is enabled", "severityDefault": "medium", "isoReferences": ["A.12.4.1"] },
    { "testKey": "akamai.siem.all_policies_covered", "title": "SIEM export covers every security policy", "severityDefault": "medium", "isoReferences": ["A.12.4.1"] },
    { "testKey": "akamai.api.discovery_enabled", "title": "API discovery is active for protected hostnames", "severityDefault": "medium", "isoReferences": ["A.13.1.1"] },
    { "testKey": "akamai.api.no_unregistered_endpoints", "title": "No discovered-but-unregistered API endpoints", "severityDefault": "high", "isoReferences": ["A.13.1.1"] },
    { "testKey": "akamai.api.endpoint_constraints_enforced", "title": "Registered API endpoints enforce request constraints", "severityDefault": "medium", "isoReferences": ["A.14.1.3"] },
    { "testKey": "akamai.property.force_https", "title": "Production properties force HTTPS", "severityDefault": "high", "isoReferences": ["A.14.1.2"] },
    { "testKey": "akamai.property.min_tls_1_2", "title": "Edge TLS floor is TLS 1.2 or higher", "severityDefault": "high", "isoReferences": ["A.10.1.1"] },
    { "testKey": "akamai.property.hsts_enabled", "title": "HTTPS properties send HSTS", "severityDefault": "medium", "isoReferences": ["A.14.1.2"] },
    { "testKey": "akamai.property.latest_version_active", "title": "Property production version is current", "severityDefault": "low", "isoReferences": ["A.12.1.2"] },
    { "testKey": "akamai.property.origin_protected", "title": "Origin is shielded from direct access", "severityDefault": "low", "isoReferences": ["A.13.1.3"] },
    { "testKey": "akamai.cps.no_certs_near_expiry", "title": "No production certificate expires soon", "severityDefault": "critical", "isoReferences": ["A.10.1.1"] },
    { "testKey": "akamai.cps.auto_renewal_enabled", "title": "Certificates renew automatically or have an owner", "severityDefault": "high", "isoReferences": ["A.10.1.2"] },
    { "testKey": "akamai.cps.strong_key_algorithm", "title": "Certificate keys meet the strength floor", "severityDefault": "high", "isoReferences": ["A.10.1.1"] },
    { "testKey": "akamai.cps.no_stuck_changes", "title": "No certificate change is stuck in progress", "severityDefault": "medium", "isoReferences": ["A.12.1.2"] }
  ]
}
