    { "testKey": "sophos.common.admin_count_reasonable", "title": "Sophos Central admin count is within the expected bound", "severityDefault": "medium", "isoReferences": ["A.9.2.3"] },
    { "testKey": "sophos.common.super_admin_least_privilege", "title": "Super Admin role membership is minimal", "severityDefault": "high", "isoReferences": ["A.9.2.3"] },
    { "testKey": "sophos.common.mfa_enforced", "title": "MFA is enforced for Sophos Central admin sign-in", "severityDefault": "high", "isoReferences": ["A.9.4.2"] },
    { "testKey": "sophos.detections.critical_resolved", "title": "No open critical XDR detections", "severityDefault": "critical", "isoReferences": ["A.16.1.5"] },
    { "testKey": "sophos.detections.high_reviewed", "title": "No high-severity detections unreviewed past the threshold", "severityDefault": "high", "isoReferences": ["A.16.1.4"] },
    { "testKey": "sophos.detections.feed_active", "title": "Detections feed has produced data within the lookback window", "severityDefault": "low", "isoReferences": ["A.12.4.1"] },
    { "testKey": "sophos.audit.log_retrievable", "title": "Audit events are retrievable for the full lookback window", "severityDefault": "medium", "isoReferences": ["A.12.4.1"] },
    { "testKey": "sophos.audit.admin_activity_logged", "title": "Administrative changes appear in the audit log (completeness sanity check)", "severityDefault": "medium", "isoReferences": ["A.12.4.3"] },
    { "testKey": "sophos.audit.api_credential_changes_reviewed", "title": "API-credential create/delete events are surfaced for review", "severityDefault": "medium", "isoReferences": ["A.9.2.5"] },
    { "testKey": "sophos.xdr.data_lake_queryable", "title": "The Sophos Data Lake responds to a baseline query", "severityDefault": "low", "isoReferences": ["A.12.4.1"] },
    { "testKey": "sophos.xdr.telemetry_coverage", "title": "Data Lake telemetry is present for the expected device population", "severityDefault": "medium", "isoReferences": ["A.12.2.1"] },
    { "testKey": "sophos.xdr.no_stale_telemetry", "title": "No devices are missing from Data Lake telemetry past the threshold", "severityDefault": "medium", "isoReferences": ["A.12.4.1"] },
    { "testKey": "sophos.siem.events_flowing", "title": "The SIEM events endpoint is returning recent events", "severityDefault": "medium", "isoReferences": ["A.12.4.1"] },
    { "testKey": "sophos.siem.alerts_current", "title": "The SIEM alerts endpoint is reachable and current", "severityDefault": "medium", "isoReferences": ["A.16.1.2"] },
    { "testKey": "sophos.siem.integration_credential_active", "title": "An active API credential exists for SIEM/log export", "severityDefault": "low", "isoReferences": ["A.12.4.1"] },
