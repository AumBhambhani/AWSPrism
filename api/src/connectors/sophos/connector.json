    { "testKey": "sophos.firewall.ha_configured", "title": "Firewalls expected to be resilient are in an HA pair", "severityDefault": "medium", "isoReferences": ["A.13.1.1"] },
    { "testKey": "sophos.firewall.config_sync_healthy", "title": "Firewall-group configuration sync reports no errors", "severityDefault": "medium", "isoReferences": ["A.12.1.2"] },
    { "testKey": "sophos.web.policy_assigned", "title": "A Web Control policy is assigned to every endpoint group", "severityDefault": "medium", "isoReferences": ["A.13.1.1"] },
    { "testKey": "sophos.web.risky_categories_blocked", "title": "High-risk web categories are blocked in policy", "severityDefault": "medium", "isoReferences": ["A.13.1.1"] },
    { "testKey": "sophos.web.download_scanning_enabled", "title": "Web download scanning / TLS inspection is enabled", "severityDefault": "medium", "isoReferences": ["A.13.1.1"] },
    { "testKey": "sophos.web.no_blanket_allow", "title": "No blanket allow-all website exceptions are configured", "severityDefault": "medium", "isoReferences": ["A.9.4.1"] },
    { "testKey": "sophos.dns.protection_active", "title": "At least one DNS Protection location is active", "severityDefault": "medium", "isoReferences": ["A.13.1.1"] },
    { "testKey": "sophos.dns.malware_categories_blocked", "title": "DNS policies block malware / phishing / C2 categories", "severityDefault": "high", "isoReferences": ["A.12.2.1"] },
    { "testKey": "sophos.dns.all_locations_have_policy", "title": "Every DNS location is bound to a policy (not default-only)", "severityDefault": "medium", "isoReferences": ["A.13.1.1"] },
    { "testKey": "sophos.dns.safe_search_enforced", "title": "Safe search is enforced in DNS policy", "severityDefault": "low", "isoReferences": ["A.13.1.1"] },
    { "testKey": "sophos.dns.custom_blocklist_present", "title": "A maintained custom domain block list exists", "severityDefault": "low", "isoReferences": ["A.13.1.1"] }
