{
  "key": "sophos",
  "name": "Sophos Central",
  "category": "endpoint_security",
  "authType": "oauth2",
  "tests": [
    { "testKey": "sophos.endpoint.protection_health", "title": "All managed endpoints report good overall health", "severityDefault": "high", "isoReferences": ["A.12.2.1"] },
    { "testKey": "sophos.endpoint.tamper_protection_enabled", "title": "Tamper Protection is enabled on every device", "severityDefault": "high", "isoReferences": ["A.12.2.1"] },
    { "testKey": "sophos.endpoint.services_running", "title": "All required Sophos protection services are running", "severityDefault": "high", "isoReferences": ["A.12.2.1"] },
    { "testKey": "sophos.endpoint.threat_policy_baseline", "title": "Threat Protection policies keep real-time scanning, live protection and deep learning on", "severityDefault": "high", "isoReferences": ["A.12.2.1"] },
    { "testKey": "sophos.endpoint.exploit_mitigation_clear", "title": "No unresolved exploit-mitigation detections", "severityDefault": "high", "isoReferences": ["A.12.6.1"] },
    { "testKey": "sophos.endpoint.no_stale_devices", "title": "No devices have gone unseen past the staleness threshold without review", "severityDefault": "medium", "isoReferences": ["A.8.1.1"] },
    { "testKey": "sophos.endpoint.isolation_reviewed", "title": "No devices left self-isolated without an open case", "severityDefault": "medium", "isoReferences": ["A.16.1.5"] },
    { "testKey": "sophos.endpoint.encryption_enabled", "title": "Device Encryption is active where the product is assigned", "severityDefault": "medium", "isoReferences": ["A.10.1.1"] },
