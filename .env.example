POSTGRES_DB=compliance
POSTGRES_USER=compliance
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://compliance:change_me@db:5432/compliance
JWT_SECRET=change_me
CORS_ORIGIN=http://localhost:5173
API_PORT=4000
WEB_PORT=5173
VITE_API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
# Must be an externally-reachable URL — GitHub's manifest/install redirects hit
# this directly. For local dev, front the API with a tunnel (e.g. ngrok) to
# exercise the real GitHub App flow end-to-end.
API_URL=http://localhost:4000
# Outbound email (Gmail SMTP). Gmail needs 2FA enabled + an App Password as
# SMTP_PASSWORD (not the account password). EMAIL_FROM must equal SMTP_USER or a
# Gmail "Send mail as" verified alias, or Gmail rewrites the From header.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=team@prismgrc.co
SMTP_PASSWORD=
EMAIL_FROM=team@prismgrc.co
# Internal address notified when a company completes the self-assessment.
TEAM_NOTIFY_EMAIL=team@prismgrc.co
# Address a superadmin-generated gap-assessment report is emailed to.
GAP_REPORT_RECIPIENT=ab@neozaar.com
# AI evidence/policy analysis. bedrock (default) | azure | none.
# "none" disables LLM calls: evidence suggestions fall back to keyword matching
# and the analyze buttons return a "not configured" notice instead of results.
PRISM_AI_PROVIDER=bedrock
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_REGION must be one the BEDROCK_CHAT_MODEL profile is valid in — an "eu.*"
# inference profile needs an eu-* region, a "us.*" profile a us-* region.
AWS_REGION=eu-north-1
# Model used for analysis. Must match AWS_REGION's prefix (eu.* / us.*).
BEDROCK_CHAT_MODEL=eu.amazon.nova-pro-v1:0
# Optional: legacy alias, only read if BEDROCK_CHAT_MODEL is unset
# BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-8-20250514-v1:0


# Super Admin (platform-level account)
SUPERADMIN_EMAIL=superadmin@auditready.com
SUPERADMIN_PASSWORD=change_me

# Google Analytics 4 (Measurement ID)
VITE_GA_ID=G-*********

# Base64-encoded 32-byte key used to encrypt integration credentials at rest.
# Also required to use per-company evidence storage (BYO S3 / Azure Blob).
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
